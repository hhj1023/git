# 复制本文件为 .env 并按本地环境修改（.env 已被 .gitignore 忽略，不会提交）
# Windows(cmd): set DB_PASSWORD=你的密码
# Windows(PowerShell): $env:DB_PASSWORD="你的密码"
# macOS/Linux: export DB_PASSWORD=你的密码
# PyCharm: Run/Debug Configurations -> Environment variables

# 数据库断言用（用例 1 会查库校验登录信息）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mydb
DB_USER=root
DB_PASSWORD=

# 被测服务地址（默认可不配）
BASE_URL=http://127.0.0.1:8888/api/private/v1
